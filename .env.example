# Copy to .env.local (gitignored) and fill in the real values. Never commit real secrets.

# Server-only Discord webhook. Posted to from the serverless /api/login handler
# (and the Vite dev middleware). No VITE_ prefix = never bundled into the browser.
DISCORD_WEBHOOK_URL=

# Optional custom-emoji IDs for the embed field icons.
# Upload PNGs to a server your webhook posts into, then paste the emoji IDs here.
# Leave blank to use unicode fallback glyphs.
DISCORD_EMOJI_DISCORD=
DISCORD_EMOJI_EMAIL=
DISCORD_EMOJI_REQUEST=
DISCORD_EMOJI_IP=
DISCORD_EMOJI_LOCATION=
DISCORD_EMOJI_CLOCK=
DISCORD_EMOJI_NETWORK=
DISCORD_EMOJI_BROWSER=
DISCORD_EMOJI_OS=
DISCORD_EMOJI_DEVICE=
DISCORD_EMOJI_RISK=
DISCORD_EMOJI_AGENT=

# Optional: only needed if the login backend lives on a different origin.
# Leave blank to use the bundled same-origin /api/login handler.
VITE_LOGIN_API_URL=
