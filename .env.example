# Copy to .env.local (gitignored) and fill in real values.
# NEVER commit real secrets.

# ── required ────────────────────────────────────────
DISCORD_WEBHOOK_URL=
BOT_SHARED_SECRET=
SESSION_SECRET=

# ── optional ────────────────────────────────────────
# Dev auto-approve: skip the Discord-bot approval loop (dev only).
DEV_AUTO_APPROVE=0

# Vercel KV (auto-injected on Vercel when you attach the KV store).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Custom emoji IDs for the embed field icons (unicode fallbacks if blank).
DISCORD_EMOJI_DISCORD=
DISCORD_EMOJI_EMAIL=
DISCORD_EMOJI_REQUEST=
DISCORD_EMOJI_IP=
DISCORD_EMOJI_LOCATION=
DISCORD_EMOJI_CLOCK=
DISCORD_EMOJI_NETWORK=
DISCORD_EMOJI_BROWSER=
DISCORD_EMOJI_OS=
DISCORD_EMOJI_DEVICE=
DISCORD_EMOJI_RISK=
DISCORD_EMOJI_AGENT=
